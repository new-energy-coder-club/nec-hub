{
  "name": "nec-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "REGISTRY",
      "id": "f5e9c203cc5b4bdea90e378df9783b78",
      "preview_id": "nec-hub-registry-preview"
    }
  ],
  "r2_buckets": [
    {
      "binding": "APPS_BUCKET",
      "bucket_name": "nec-hub-apps",
      "preview_bucket_name": "nec-hub-apps-preview"
    }
  ],
  "d1_databases": [
    {
      "binding": "ERP_DB",
      "database_name": "nec-hub-erp",
      "database_id": "aefb1970-6a30-4be5-aa4d-6481f3f89727",
      "migrations_dir": "migrations/erp"
    }
  ],
  "routes": [
    {
      "pattern": "hub.newenergycoder.club",
      "custom_domain": true
    },
    {
      // 泛域名应用直达：<app>.<zone> → R2 apps/<app>/（domains/wildcard.ts）
      // 另需在 Cloudflare DNS 加一条 * 的代理记录（AAAA → 100::，橙云），Universal SSL 覆盖三级泛域名
      "pattern": "*.newenergycoder.club/*",
      "zone_name": "newenergycoder.club"
    }
  ],
  "triggers": {
    // 时间窗驱动（见 src/index.ts scheduled）：触发器只是"事件源"，任务按 UTC 时间窗分发 + guard 去重。
    // 小时级任务（:24 窗口）由快触发器兜底，无需单独的 23 *；本账户触发器增删疑似不生效，残留触发器由 handler 兼容。
    "crons": ["*/8 * * * *", "0 0 * * 1"]
  },
  "vars": {
    "HUB_NAME": "NEC 团队 AI 中台"
  }
}
