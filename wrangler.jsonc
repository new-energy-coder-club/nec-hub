{
  "name": "nec-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "REGISTRY",
      "id": "f5e9c203cc5b4bdea90e378df9783b78",
      "preview_id": "nec-hub-registry-preview"
    }
  ],
  "r2_buckets": [
    {
      "binding": "APPS_BUCKET",
      "bucket_name": "nec-hub-apps",
      "preview_bucket_name": "nec-hub-apps-preview"
    }
  ],
  "routes": [
    {
      "pattern": "hub.newenergycoder.club",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["*/4 * * * *", "23 * * * *", "0 0 * * 1"]
  },
  "vars": {
    "HUB_NAME": "NEC 团队 AI 中台"
  }
}
